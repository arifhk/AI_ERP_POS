# Public API origin used by the browser (no trailing slash).
# Local dev talks to uvicorn directly. On Vercel, leave this unset so the app
# calls /pos-api, which vercel.json proxies to the Render service.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only Upstash Redis cache for the POS product catalog.
# Sync still succeeds when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-only Supabase catalog fallback. Never prefix the service key with NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
