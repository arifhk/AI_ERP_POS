# Copy to .env and replace placeholder secrets before production.

# JWT signing — generate a long random value for production.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite (local / default Docker volume):
DATABASE_URL=sqlite+aiosqlite:///./erp_pos.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/erp_pos

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
