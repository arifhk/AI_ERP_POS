# Copy to .env and restart Expo (`npx expo start`).
#
# Do NOT use http://localhost:8000 on a physical phone — that points at the phone itself.
# Use the computer's LAN IPv4 from `ipconfig` (Windows) or `ifconfig` (macOS/Linux).
#
# Example (this machine's Ethernet IPv4 at setup time):
EXPO_PUBLIC_API_URL=http://192.168.0.108:8000
#
# Android emulator: http://10.0.2.2:8000
# iOS simulator:    http://localhost:8000
#
# FastAPI must bind all interfaces:
#   cd backend
#   uvicorn main:app --reload --host 0.0.0.0 --port 8000
